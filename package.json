{
  "name": "ownerlens",
  "repository": {
    "type": "git",
    "url": "https://github.com/kodevza/OwnerLens"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "version": "0.1.0",
  "description": "Azure ownership reporting tool for resolving likely owners of subscriptions and resource groups from snapshot data.",
  "license": "Apache-2.0",
  "bin": {
    "ownerlens": "./bin/ownerlens.js"
  },
  "files": [
    "bin",
    "dist",
    "index.html",
    "src",
    "tools",
    "vite.config.ts"
  ],
  "keywords": [
    "azure",
    "entra",
    "ownership",
    "reporting",
    "governance"
  ],
  "type": "module",
  "scripts": {
    "start": "node ./bin/ownerlens.js start",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "node ./bin/ownerlens.js preview",
    "collect:entra": "node ./bin/ownerlens.js collect:entra",
    "collect:azure": "node ./bin/ownerlens.js collect:azure",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts",
    "lint:unused": "ts-prune",
    "test": "npm run test:node && npm run test:duckdb",
    "test:node": "node --expose-gc ./node_modules/jest/bin/jest.js --runInBand",
    "test:duckdb": "node tools/run-duckdb-jest.cjs",
    "test:all": "npm test && npm run test:components",
    "test:components": "jest --runInBand --config jest.components.config.cjs",
    "test:e2e": "playwright test",
    "test:e2e:validation": "playwright test tests/e2e/resource-groups.validation.spec.ts",
    "test:coverage": "npm run test:node -- --coverage --coverageDirectory coverage/node && npm run test:duckdb -- --coverage --coverageDirectory coverage/duckdb && npm run test:components -- --coverage && npm run test:coverage:merge",
    "test:coverage:merge": "node tools/merge-coverage.cjs",
    "test:components:coverage": "npm run test:coverage",
    "deps:graph:folders:dot": "depcruise src --config .dependency-cruiser.cjs --output-type dot --collapse 4 --include-only '^src' --output-to output/dependency-folders.dot",
    "deps:graph:folders": "npm run deps:graph:folders:dot && dot -Tsvg output/dependency-folders.dot -o output/dependency-folders.svg",
    "deps:graph:files:dot": "depcruise src --config .dependency-cruiser.cjs --output-type dot --include-only '^src' --output-to output/dependency-files.dot",
    "deps:graph:files": "npm run deps:graph:files:dot && dot -Tsvg output/dependency-files.dot -o output/dependency-files.svg",
    "deps:graph": "npm run deps:graph:folders"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.3-r.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-prune": "^0.10.3",
    "typescript-eslint": "^8.60.1"
  }
}
